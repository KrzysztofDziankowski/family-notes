#!/bin/sh
set -eu

RELEASES=/srv/family-notes/releases
CURRENT=/srv/family-notes/current
ENV_FILE=/etc/family-notes/env
BACKUPS=/var/backups/family-notes
RELEASE_GATE_LIBRARY=/usr/local/libexec/family-notes/release-gate.sh
EXPECTED_RELEASE_GATE_PROTOCOL_VERSION=1

fail() {
    echo "family-notes-deploy: $*" >&2
    exit 1
}

validate_release() {
    release_id=${1:-}
    case "$release_id" in
        [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
        *) fail "invalid release ID: $release_id" ;;
    esac
    release_dir="$RELEASES/$release_id"
    [ -d "$release_dir" ] || fail "release does not exist: $release_id"
    [ -x "$release_dir/.venv/bin/python" ] || fail "release virtual environment is missing"
    [ -f "$release_dir/manage.py" ] || fail "manage.py is missing"
}

load_environment() {
    set -a
    # shellcheck disable=SC1090
    . "$ENV_FILE"
    set +a
}

run_manage() {
    release_dir=$1
    shift
    runuser -u familynotes -- sh -c 'cd "$1" && shift && exec .venv/bin/python manage.py "$@"' sh "$release_dir" "$@"
}

# A fixed recovery action: no arbitrary release, command, or option is accepted.
reset_admin_login() {
    [ "$#" -eq 2 ] || fail "usage: reset-admin-login USER_ID CLIENT_IP"
    case "$1" in ''|*[!0-9]*|0|0*) fail "invalid operator ID" ;; esac
    case "$2" in ''|*[!0-9a-fA-F.:]*) fail "invalid client IP" ;; esac
    reset_release=$(readlink -f "$CURRENT") || fail "current release is unavailable"
    case "$reset_release" in "$RELEASES"/*) ;; *) fail "current release is invalid" ;; esac
    [ "$reset_release" = "$RELEASES/${reset_release##*/}" ] || fail "current release is invalid"
    validate_release "${reset_release##*/}"
    load_environment
    run_manage "$release_dir" reset_admin_login_limits --user-id "$1" --client-ip "$2"
}

health_probe() {
    health_budget=$1
    case "$health_budget" in
        ''|*[!0-9]*|0) return 1 ;;
    esac
    umask 077
    health_response=$(mktemp)
    trap 'rm -f "$health_response"' EXIT HUP INT TERM
    if curl --fail --silent --show-error --max-time "$health_budget" \
        --unix-socket /run/family-notes/gunicorn.sock \
        -H "Host: $health_host" -H 'X-Forwarded-Proto: https' \
        --output "$health_response" http://localhost/healthz/ \
        && printf '%s' '{"status": "ok"}' | cmp -s - "$health_response"; then
        health_result=0
    else
        health_result=1
    fi
    rm -f "$health_response"
    trap - EXIT HUP INT TERM
    return "$health_result"
}

health_clock() { date -u +%s; }
health_sleep() { sleep "$1"; }

# One probe of the conversion worker's health. Prints only a fixed state word
# (ok, disabled, unavailable, or unexpected), never the response body. Succeeds
# for ok and disabled; the release gate above never depends on it.
conversion_health_probe() {
    conversion_budget=$1
    case "$conversion_budget" in
        ''|*[!0-9]*|0) return 1 ;;
    esac
    umask 077
    conversion_response=$(mktemp)
    trap 'rm -f "$conversion_response"' EXIT HUP INT TERM
    conversion_code=$(curl --silent --max-time "$conversion_budget" \
        --unix-socket /run/family-notes/gunicorn.sock \
        -H "Host: $health_host" -H 'X-Forwarded-Proto: https' \
        --output "$conversion_response" --write-out '%{http_code}' \
        http://localhost/healthz/conversion/) || conversion_code=000
    conversion_state=unexpected
    for conversion_candidate in 200:ok 200:disabled 503:unavailable; do
        if [ "$conversion_code" = "${conversion_candidate%%:*}" ] \
            && printf '{"status": "%s"}' "${conversion_candidate#*:}" \
                | cmp -s - "$conversion_response"; then
            conversion_state=${conversion_candidate#*:}
            break
        fi
    done
    rm -f "$conversion_response"
    trap - EXIT HUP INT TERM
    printf 'conversion health: %s\n' "$conversion_state"
    case "$conversion_state" in
        ok|disabled) return 0 ;;
        *) return 1 ;;
    esac
}

# Tests source the helper to exercise its functions with fake commands. The
# mode only returns early when sourced; executing the helper (installed or
# staged) with it set fails before any action.
if [ "${FAMILY_NOTES_DEPLOY_SOURCE_ONLY:-}" = 1 ]; then
    case "${0##*/}" in
        family-notes-deploy|family-notes-deploy.new)
            echo "family-notes-deploy: source-only mode requires sourcing" >&2
            exit 1
            ;;
    esac
    return 0
fi

[ -r "$RELEASE_GATE_LIBRARY" ] || {
    echo "family-notes-deploy: release gate library is unavailable" >&2
    exit 1
}
# shellcheck disable=SC1090
. "$RELEASE_GATE_LIBRARY"
[ "${RELEASE_GATE_PROTOCOL_VERSION:-}" = "$EXPECTED_RELEASE_GATE_PROTOCOL_VERSION" ] || {
    echo "family-notes-deploy: incompatible release gate protocol" >&2
    exit 1
}

command=${1:-}
case "$command" in
    reset-admin-login)
        [ "$#" -eq 3 ] || fail "usage: $0 reset-admin-login USER_ID CLIENT_IP"
        reset_admin_login "$2" "$3"
        ;;
    check)
        [ "$#" -eq 2 ] || fail "usage: $0 check RELEASE_ID"
        validate_release "$2"
        load_environment
        run_manage "$release_dir" check --deploy
        run_manage "$release_dir" makemigrations --check --dry-run
        ;;
    backup)
        [ "$#" -eq 2 ] || fail "usage: $0 backup RELEASE_ID"
        validate_release "$2"
        load_environment
        install -d -o root -g root -m 0700 "$BACKUPS"
        umask 077
        backup_file="$BACKUPS/pre-release-$2.dump"
        [ ! -e "$backup_file" ] || fail "backup already exists: $backup_file"
        PGPASSWORD="$DB_PASSWORD" pg_dump -Fc -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" "$DB_NAME" -f "$backup_file"
        test -s "$backup_file" || fail "backup is empty: $backup_file"
        echo "$backup_file"
        ;;
    activate)
        [ "$#" -eq 2 ] || fail "usage: $0 activate RELEASE_ID"
        validate_release "$2"
        load_environment
        run_manage "$release_dir" migrate --noinput
        run_manage "$release_dir" collectstatic --noinput
        ln -sfn "$release_dir" "$CURRENT"
        systemctl restart family-notes
        systemctl is-active --quiet family-notes
        ;;
    rollback)
        [ "$#" -eq 2 ] || fail "usage: $0 rollback RELEASE_ID"
        validate_release "$2"
        ln -sfn "$release_dir" "$CURRENT"
        systemctl restart family-notes
        systemctl is-active --quiet family-notes
        ;;
    status)
        [ "$#" -eq 1 ] || fail "usage: $0 status"
        readlink -f "$CURRENT"
        systemctl status family-notes --no-pager
        ;;
    logs)
        [ "$#" -eq 1 ] || fail "usage: $0 logs"
        journalctl -u family-notes -n 100 --no-pager
        ;;
    gate-version)
        [ "$#" -eq 1 ] || fail "usage: $0 gate-version"
        printf '%s\n' "$RELEASE_GATE_PROTOCOL_VERSION"
        ;;
    health)
        [ "$#" -eq 1 ] || fail "usage: $0 health"
        load_environment
        health_host=${DJANGO_ALLOWED_HOSTS%%,*}
        [ -n "$health_host" ] || fail "DJANGO_ALLOWED_HOSTS is empty"
        release_gate_wait health_probe health_clock health_sleep
        ;;
    conversion-health)
        [ "$#" -eq 1 ] || fail "usage: $0 conversion-health"
        load_environment
        health_host=${DJANGO_ALLOWED_HOSTS%%,*}
        [ -n "$health_host" ] || fail "DJANGO_ALLOWED_HOSTS is empty"
        conversion_health_probe 10
        ;;
    reboot)
        [ "$#" -eq 1 ] || fail "usage: $0 reboot"
        systemctl reboot
        ;;
    *)
        fail "usage: $0 {check|backup|activate|rollback|status|logs|gate-version|health|conversion-health|reboot|reset-admin-login} [arguments]"
        ;;
esac
