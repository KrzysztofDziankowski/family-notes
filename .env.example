# Local Django settings
DJANGO_SECRET_KEY=replace-with-a-local-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,::1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:20121,http://127.0.0.1:20121,http://[::1]:20121
# Production-only overrides:
# DJANGO_STATIC_ROOT=/var/www/family-notes/static
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=3600
# Production login limits use the existing database; apply migrations before release.
# Optional development database-backed login limits:
# DJANGO_AUTH_DB_CACHE=True

# Keep SQLite for zero-setup local development.
DB_ENGINE=sqlite
DB_NAME=db.sqlite3

# To use PostgreSQL, set DB_ENGINE=postgresql and uncomment all values below.
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_SSLMODE=prefer
# DB_NAME=family_notes
# DB_USER=family_notes
# DB_PASSWORD=replace-with-your-local-database-password

# Required when Google sign-in is enabled locally or in production.
# Never commit real client IDs or secrets.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Natural-language classification (OpenAI). Disabled unless explicitly enabled.
# Never commit a real API key. The app sends store=False on every request, but
# store=False does NOT replace Zero Data Retention (ZDR); ZDR is deferred until
# after the MVP, so OpenAI may retain API traffic for abuse monitoring. With
# DJANGO_DEBUG=False, enabling classification without the key and a
# structured-output-capable model stops startup; in any mode the provider
# client is not built until both are present.
# Production enablement is an operator step: set these values only in the
# protected server environment,
# and run the synthetic smoke check and sensitive-sentinel log inspection in
# context/changes/deployment/mikrus-runbook.md ("Enable Classification").
# Never set OPENAI_LOG=debug in production.
CLASSIFICATION_ENABLED=False
OPENAI_API_KEY=
# Recommended: gpt-5.4-nano with OPENAI_REASONING_EFFORT=none (2026-10-03 live
# date test: all dates correct; gpt-5-nano/minimal got relative dates wrong).
OPENAI_CLASSIFICATION_MODEL=
# Reasoning models (e.g. gpt-5-nano) count reasoning tokens against the output
# limit and may return incomplete output; set low or minimal for them, or none
# for gpt-5.4-nano. Leave empty for non-reasoning models, which reject the
# parameter.
OPENAI_REASONING_EFFORT=
# Timing policy (seconds): hard application deadline, per-attempt timeout, and
# at most one application-owned retry (SDK retries are always disabled).
# CLASSIFICATION_DEADLINE_SECONDS=25
# CLASSIFICATION_ATTEMPT_TIMEOUT_SECONDS=10
# CLASSIFICATION_MAX_RETRIES=1

# EduVulcan notification conversion worker (roadmap S-05). Disabled unless
# explicitly enabled. When enabled, each Gunicorn worker process started with
# `--config gunicorn.conf.py` runs one background conversion thread; runserver,
# tests, and management commands never start it. GET /healthz/conversion/
# reports disabled, ok, or unavailable (no fresh heartbeat from a worker of the
# running release). Invalid numbers stop startup. Deploy migrations with the
# worker disabled, then enable it.
EDUVULCAN_WORKER_ENABLED=False
# EDUVULCAN_CONVERSION_SWEEP_INTERVAL_SECONDS=60
# EDUVULCAN_CONVERSION_BATCH_SIZE=50
# Must be at least CLASSIFICATION_DEADLINE_SECONDS + 30.
# EDUVULCAN_CONVERSION_LEASE_SECONDS=120
# EDUVULCAN_CONVERSION_MAX_ATTEMPTS=3
# Delays before attempt 2 and attempt 3 (comma-separated seconds).
# EDUVULCAN_CONVERSION_RETRY_DELAYS_SECONDS=60,300
# EDUVULCAN_RAW_RETENTION_DAYS=90
# EDUVULCAN_WORKER_HEARTBEAT_SECONDS=30
# Must be greater than EDUVULCAN_WORKER_HEARTBEAT_SECONDS.
# EDUVULCAN_WORKER_HEARTBEAT_MAX_AGE_SECONDS=180
# Release identity stamped on worker heartbeats; health counts only heartbeats
# of the running release. Defaults to the resolved project directory's name
# (the release directory on the server), so leave it unset there.
# FAMILY_NOTES_RELEASE_ID=
