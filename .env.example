# Local Django settings
DJANGO_SECRET_KEY=replace-with-a-local-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,::1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:20121,http://127.0.0.1:20121,http://[::1]:20121
# Production-only overrides:
# DJANGO_STATIC_ROOT=/var/www/family-notes/static
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=3600

# Keep SQLite for zero-setup local development.
DB_ENGINE=sqlite
DB_NAME=db.sqlite3

# To use PostgreSQL, set DB_ENGINE=postgresql and uncomment all values below.
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_SSLMODE=prefer
# DB_NAME=family_notes
# DB_USER=family_notes
# DB_PASSWORD=replace-with-your-local-database-password

# Required when Google sign-in is enabled locally or in production.
# Never commit real client IDs or secrets.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Natural-language classification (OpenAI). Disabled unless explicitly enabled.
# Never commit a real API key. The app sends store=False on every request, but
# store=False does NOT replace Zero Data Retention (ZDR); ZDR is deferred until
# after the MVP, so OpenAI may retain API traffic for abuse monitoring. With
# DJANGO_DEBUG=False, enabling classification without the key and a
# structured-output-capable model stops startup; in any mode the provider
# client is not built until both are present.
# Production enablement is an operator step: set these values only in the
# protected server environment,
# and run the synthetic smoke check and sensitive-sentinel log inspection in
# context/changes/deployment/mikrus-runbook.md ("Enable Classification").
# Never set OPENAI_LOG=debug in production.
CLASSIFICATION_ENABLED=False
OPENAI_API_KEY=
OPENAI_CLASSIFICATION_MODEL=
# Reasoning models (e.g. gpt-5-nano) count reasoning tokens against the output
# limit and may return incomplete output; set low or minimal for them. Leave
# empty for non-reasoning models, which reject the parameter.
OPENAI_REASONING_EFFORT=
# Timing policy (seconds): hard application deadline, per-attempt timeout, and
# at most one application-owned retry (SDK retries are always disabled).
# CLASSIFICATION_DEADLINE_SECONDS=25
# CLASSIFICATION_ATTEMPT_TIMEOUT_SECONDS=10
# CLASSIFICATION_MAX_RETRIES=1
