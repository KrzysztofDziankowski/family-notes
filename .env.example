# Local Django settings
DJANGO_SECRET_KEY=replace-with-a-local-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,::1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:20121,http://127.0.0.1:20121,http://[::1]:20121
# Production-only overrides:
# DJANGO_STATIC_ROOT=/var/www/family-notes/static
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=3600

# Keep SQLite for zero-setup local development.
DB_ENGINE=sqlite
DB_NAME=db.sqlite3

# To use PostgreSQL, set DB_ENGINE=postgresql and uncomment all values below.
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_SSLMODE=prefer
# DB_NAME=family_notes
# DB_USER=family_notes
# DB_PASSWORD=replace-with-your-local-database-password

# Required when Google sign-in is enabled locally or in production.
# Never commit real client IDs or secrets.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Add this only after the corresponding integration is implemented.
# AI_PROVIDER_API_KEY=
